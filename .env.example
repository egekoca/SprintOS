# Optional RPC override for the testnet web client.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Optional deployment overrides. Defaults come from apps/web/lib/stellar/deployment.json.
NEXT_PUBLIC_SETTLEMENT_CONTRACT_ID=
NEXT_PUBLIC_USDC_SAC_ID=
# Set this with a contract override only when that deployment exposes `claim`.
NEXT_PUBLIC_BUILDER_CLAIM_ENABLED=

# Required only to generate advisory reports. Human review works without it.
ANTHROPIC_API_KEY=

# Optional service token for public repository scans.
GITHUB_TOKEN=

# GitHub OAuth web flow. Register /api/github/callback as the callback URL.
# The session secret encrypts the HttpOnly GitHub session cookie; use a long,
# random value in every deployed environment.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback

# Durable deployments should point this at a persistent volume.
SPRINTOS_DATA_DIR=apps/web/.data
