# Optional RPC override for the testnet web client.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Optional deployment overrides. Defaults come from apps/web/lib/stellar/deployment.json.
NEXT_PUBLIC_SETTLEMENT_CONTRACT_ID=
NEXT_PUBLIC_USDC_SAC_ID=
# Set this with a contract override only when that deployment exposes `claim`.
NEXT_PUBLIC_BUILDER_CLAIM_ENABLED=

# Required only to generate advisory reports and milestone drafts. Human review works without it.
OPENAI_API_KEY=
# Optional override for the default OpenAI model used by the advisory helpers.
OPENAI_MODEL=

# Optional service token for public repository scans.
GITHUB_TOKEN=

# GitHub OAuth web flow. Register /api/github/callback as the callback URL.
# The session secret encrypts the HttpOnly GitHub session cookie; use a long,
# random value in every deployed environment.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback

# Where criteria, evidence and advisory reports are written.
#
# Leave both of these unset for local development: documents land in
# `apps/web/.data`. On a serverless host the filesystem does not persist, so
# create a Vercel Blob store and set its token — the app switches backends on
# its own and keeps the same content-addressed keys.
BLOB_READ_WRITE_TOKEN=
# Only for a single instance with a persistent volume. Use an absolute path:
# a relative one resolves against the web app's own directory.
SPRINTOS_DATA_DIR=

# The address this deployment is reachable at from outside, with no trailing
# slash. The evidence bundle URI is written into contract storage permanently,
# so this must be set anywhere a reviewer will read the ledger.
NEXT_PUBLIC_APP_URL=
