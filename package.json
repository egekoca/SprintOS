{
  "name": "sprintos",
  "private": true,
  "version": "0.1.0",
  "description": "Milestone review and settlement on Stellar, with an advisory AI that cannot pay anyone",
  "repository": "https://github.com/egekoca/SprintOS",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @sprintos/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "contract:test": "cargo test --package sprintos-settlement",
    "contract:build": "stellar contract build",
    "format:check": "cargo fmt --all -- --check",
    "evidence:doc": "node --experimental-strip-types scripts/write-evidence-doc.mts"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.0",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "sharp": "0.35.0",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11"
  }
}
